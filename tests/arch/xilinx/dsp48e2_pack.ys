# UltraScale+ DSP48E2 packing.

# Input/pipeline/output registers, pre-adder and post-adder all absorbed into a
# single DSP48E2.  (Functional check by co-simulation in dsp48e2.sh: equiv_opt
# cannot prove it, as the DSP M register holds the product as two partial
# products, so induction finds no matching state.)
read_verilog dsp48e2_pack.v
synth_xilinx -family xcup -noiopad -top top
cd top
select -assert-count 1 t:DSP48E2
select -assert-count 1 t:DSP48E2 r:AMULTSEL=AD %i
select -assert-count 1 t:DSP48E2 r:AREG=1 %i r:BREG=1 %i r:DREG=1 %i
# M and P registers absorbed too: nothing is left in fabric
select -assert-none t:FD* t:LUT* t:CARRY*

design -reset
# Accumulator: P feedback through the post-adder (Z = P)
read_verilog <<EOT
module top(input clk, input signed [5:0] a, input signed [4:0] b, output reg signed [15:0] acc);
  always @(posedge clk) acc <= acc + a * b;
endmodule
EOT
proc
equiv_opt -assert -async2sync -map +/xilinx/cells_sim.v synth_xilinx -family xcup -noiopad
design -load postopt
cd top
select -assert-count 1 t:DSP48E2
select -assert-none t:FD* t:LUT* t:CARRY*
